# SEIMS scenario-analysis image for surrogate-model optimization.
#
# Build from the repository root:
#   docker build --tag seims-optimizer:surrogate -f docker/Dockerfile.surrogate .

FROM python:3.10-slim

LABEL maintainer="SEIMS Team"
LABEL description="SEIMS Scenario Analysis with Surrogate Model"
LABEL version="surrogate-v1"

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgdal-dev \
    gdal-bin \
    netcat-openbsd \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Wheel caches and trained model artifacts are intentionally kept out of git.
# Use a package mirror or Docker build cache when building in restricted networks.
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir \
    numpy \
    scipy \
    matplotlib \
    pandas \
    pymongo \
    deap \
    pymoo \
    scikit-learn \
    xgboost \
    joblib \
    PyGeoC \
    networkx \
    cma \
    autograd \
    alive-progress \
    dill \
    future \
    dnspython \
    deprecated \
    wrapt \
    packaging \
    pyparsing \
    cycler \
    kiwisolver \
    pillow \
    fonttools \
    contourpy \
    python-dateutil \
    six

WORKDIR /app

COPY seims/scenario_analysis      /app/seims/scenario_analysis
COPY seims/scenario_analysis/pygeoc_local /app/seims/pygeoc
COPY docker/osgeo_stub/osgeo      /app/osgeo
COPY seims/preprocess             /app/seims/preprocess
COPY seims/postprocess            /app/seims/postprocess
COPY seims/utility                /app/seims/utility
COPY seims/run_seims.py           /app/seims/
COPY seims/global_mongoclient.py  /app/seims/
COPY seims/surrogate_model        /app/seims/surrogate_model

RUN mkdir -p /opt/seims/bin /workspace /output /data /data/youwuzhen

ENV SEIMS_HOME=/opt/seims
ENV SEIMS_DATA_DIR=/data
ENV PYTHONPATH=/app:$PYTHONPATH
ENV PATH=/opt/seims/bin:$PATH
ENV MONGODB_HOST=mongodb
ENV MONGODB_PORT=27017

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR /workspace

ENTRYPOINT ["/entrypoint.sh"]
CMD ["--help"]
